<?xml version="1.0" encoding="utf-8"?>
<!--
  Packaging the kiosk as MSIX is the only way Windows will offer it in
  Settings, Accounts, Set up a kiosk. That picker lists Microsoft Edge and
  installed packaged apps, and nothing else: a plain executable can never
  appear in it, however it is installed.

  runFullTrust is what lets a normal Win32 program ship inside a package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="Upgaming.Roaster"
            Publisher="CN=Upgaming"
            Version="1.0.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Upgaming Roaster</DisplayName>
    <PublisherDisplayName>Upgaming</PublisherDisplayName>
    <Logo>images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Roaster" Executable="kiosk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Upgaming Roaster"
        Description="Roast your GitHub and take the receipt."
        BackgroundColor="#070707"
        Square150x150Logo="images\Square150x150Logo.png"
        Square44x44Logo="images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="images\Wide310x150Logo.png" />
      </uap:VisualElements>

      <!-- Starts itself at sign-in, so the device needs no startup shortcut,
           no scheduled task and no script. -->
      <Extensions>
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="UpgamingRoaster" Enabled="true" DisplayName="Upgaming Roaster" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
