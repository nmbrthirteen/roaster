# Settings for roastd, the roast service. These belong on the machine that runs
# it and never on a kiosk device. .env is gitignored; this file holds only names.
# roastd reads its environment and nothing else, so set these however your host
# sets environment variables.

# GitHub token. Required. It needs no scopes: everything read is public.
GITHUB_TOKEN=

# Model keys. Each key you set makes its writers available in the kiosk menu,
# which picks one by name. A stand that has picked none gets the first key found,
# in the order OpenAI, xAI, Anthropic. With no key at all, the verdict is written
# from the measured numbers, which is a complete roast with no model at all.

# OpenAI API key. Enables the OpenAI current-model option and the GPT-6 Luna
# cheap option. Give it its own project in the OpenAI dashboard with a monthly
# budget, so a leak costs no more than that budget and revoking it touches
# nothing else.
OPENAI_API_KEY=

# Which OpenAI model writes the current-model option. Defaults to gpt-5.6-terra.
# GPT-6 Luna is always gpt-6-luna.
OPENAI_MODEL=

# xAI API key. Enables the Grok option in the kiosk menu.
XAI_API_KEY=

# Which Grok model writes the Grok option. Defaults to grok-4.6.
XAI_MODEL=

# Anthropic API key. Enables the Claude Opus 5 option in the kiosk menu.
ANTHROPIC_API_KEY=

# Roast archive. With both set, every finished roast is saved to Strapi: the
# handle, the roast, the event code, the terminal number and the commit feed
# shown during the audit. It serves the share page the receipt's QR code points
# at. With either unset nothing is saved and share links do not open. The
# service never deletes entries, so retention is up to your Strapi. The token
# needs to create roast entries and mark them printed.
STRAPI_URL=
STRAPI_TOKEN=

# Comma separated terminal tokens, one per stand, so a lost device is a single
# revocation. At least 24 characters each. Generate them, for example:
#   openssl rand -hex 24
# Rotate between events.
TERMINAL_TOKENS=

# Comma separated handles that must never be roasted. An account on this list is
# never read, not just never printed.
ROAST_OPT_OUT=

# Audits run at once, across every stand. Defaults to 16.
ROAST_PARALLEL=

# Port to listen on. Most hosts set this themselves. Defaults to 8080.
PORT=
