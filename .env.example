# These belong on the service that runs the roast, never on a kiosk device.
# Copy to .env there and fill in. .env is gitignored; this file holds only names.

# Anthropic API key, for the verdict and the bet slip copy.
ANTHROPIC_API_KEY=

# GitHub token. Unauthenticated requests are capped at 60 an hour, which a booth
# exhausts in about twenty minutes. A token raises it to 5000 and needs no
# scopes, since every piece of data read is public.
GITHUB_TOKEN=

# Comma separated terminal tokens the service will accept. One per stand, so a
# lost device is a single revocation. Rotate between events.
TERMINAL_TOKENS=
