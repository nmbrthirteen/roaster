# Copy to .env and fill in. Never commit the real values.
#
# The roast generation runs server-side, so these live wherever the app is
# hosted, never on a kiosk device in a public hall.

# Anthropic API key for the verdict and the bet slip copy.
ANTHROPIC_API_KEY=

# GitHub personal access token. Unauthenticated requests are capped at 60 per
# hour, which a booth exhausts in about twenty minutes. A token raises it to
# 5000. It needs no scopes: all the data read is public.
GITHUB_TOKEN=
