# Settings for roastd, the roast service. These belong on the machine that runs
# it and never on a kiosk device. .env is gitignored; this file holds only names.
# roastd reads its environment and nothing else, so set these however your host
# sets environment variables.

# GitHub token. Required. It needs no scopes: everything read is public.
GITHUB_TOKEN=

# Anthropic API key, for the verdict. Optional: without it the verdict is
# written from the measured numbers, which is a complete roast with no model.
ANTHROPIC_API_KEY=

# Comma separated terminal tokens, one per stand, so a lost device is a single
# revocation. At least 24 characters each. Generate them, for example:
#   openssl rand -hex 24
# Rotate between events.
TERMINAL_TOKENS=

# Comma separated handles that must never be roasted. An account on this list is
# never read, not just never printed.
ROAST_OPT_OUT=

# Audits run at once, across every stand. Defaults to 16.
ROAST_PARALLEL=

# Port to listen on. Most hosts set this themselves. Defaults to 8080.
PORT=
