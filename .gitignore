# Build output
/dist/
/surface/
*.exe
/roaster
/kiosk

# Per-device settings and runtime state, written by the app itself
roaster.json
*.log

# Secrets. The roast generation reads these from the environment.
.env
.env.*
!.env.example

.DS_Store

# Edge profile the launcher creates
kiosk-profile/

# Terminal token, machine-bound. Never commit.
terminal.token
