# Build output
/dist/
/surface/
*.exe
/roaster
/kiosk

# Per-device settings and runtime state, written by the app itself
roaster.json
*.log

# Secrets. The roast generation reads these from the environment.
.env
.env.*
!.env.example

.DS_Store

# Where the view keeps its cache and storage
kiosk-data/

# Terminal token, machine-bound. Never commit.
terminal.token

# Written by the hidden menu when an operator leaves
.quit
